PORT=3000
NODE_ENV=development
APP_ORIGIN=https://localhost
SESSION_TTL_SECONDS=604800
# Exact Nginx container IP, if assigned by your deployment. Blank trusts no proxy.
TRUSTED_PROXY_IP=

# PostgreSQL Configuration
POSTGRES_DB=chess
POSTGRES_USER=chess_owner
POSTGRES_PASSWORD=replace-with-owner-secret
APP_DB_USER=chess_app
APP_DB_PASSWORD=replace-with-app-secret

# Database Connection URLs
DATABASE_URL=postgresql://chess_app:replace-with-app-secret@postgres:5432/chess
MIGRATION_DATABASE_URL=postgresql://chess_owner:replace-with-owner-secret@postgres:5432/chess

# Initial Admin Bootstrap
ADMIN_EMAIL=admin@transcendence.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Leave LLM_API_KEY blank to disable the AI chat.
# The backend uses the OpenAI "chat completions" format, which both OpenAI and
# Google Gemini (via its OpenAI-compatible endpoint) accept. Pick one:
#
#   Gemini:  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#            LLM_MODEL=gemini-3.5-flash-lite   (newer *-flash models "think" and
#            may time out; *-flash-lite is fast. Some models are blocked for new keys.)
#
#   OpenAI:  LLM_BASE_URL=https://api.openai.com/v1
#            LLM_MODEL=gpt-4o-mini
#
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_MS=30000
