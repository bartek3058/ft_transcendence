{
  "name": "ft-transcendence-backend",
  "version": "0.0.1",
  "description": "NestJS backend for ft_transcendence",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "npm run build && node --test test/*.test.cjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "test:db": "ts-node --project tsconfig.tools.json test/database-security-and-schema.test.ts",
    "test:bootstrap": "ts-node --project tsconfig.tools.json test/admin-bootstrap.test.ts",
    "test:auth:db": "npm run build && node --test test/integration/auth-postgres.test.cjs",
    "test:elo": "ts-node --project tsconfig.tools.json test/elo.test.ts",
    "test:matchmaking": "ts-node --project tsconfig.tools.json test/matchmaking-pairing.test.ts",
    "test:matchmaking:service": "ts-node --project tsconfig.tools.json test/matchmaking-service.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/platform-socket.io": "^10.0.0",
    "@nestjs/websockets": "^10.0.0",
    "socket.io": "^4.8.0",
    "argon2": "0.44.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "express": "4.22.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "@prisma/client": "^5.22.0",
    "chess.js": "^1.4.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@types/express": "^4.17.17",
    "@types/node": "^20.3.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3",
    "prisma": "^5.22.0"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "prisma": {
    "seed": "ts-node --project tsconfig.tools.json prisma/seed.ts"
  }
}
