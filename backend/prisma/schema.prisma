datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique(map: "users_email_key") @db.VarChar(254)
  username     String     @unique(map: "users_username_key") @db.VarChar(20)
  rating       Int        @default(1200)
  passwordHash String     @map("password_hash") @db.Text
  role         String     @default("user") @db.VarChar(20)
  status       String     @default("offline") @db.VarChar(20)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions     Session[]
  whiteGames   Game[]     @relation("WhitePlayer")
  blackGames   Game[]     @relation("BlackPlayer")
  movesPlayed  GameMove[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique(map: "sessions_token_hash_key") @map("token_hash") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Game {
  id                String     @id @default(uuid()) @db.Uuid
  whiteId           String?    @map("white_id") @db.Uuid
  blackId           String?    @map("black_id") @db.Uuid
  result            String     @default("IN_PROGRESS") @db.VarChar(16)
  endReason         String?    @map("end_reason") @db.VarChar(32)
  timeControl       String?    @map("time_control") @db.VarChar(32)
  whiteRating       Int?       @map("white_rating")
  blackRating       Int?       @map("black_rating")
  whiteRatingChange Int?       @map("white_rating_change")
  blackRatingChange Int?       @map("black_rating_change")
  pgn               String?    @db.Text
  gameStart         DateTime   @default(now()) @map("game_start") @db.Timestamptz(3)
  gameEnd           DateTime?  @map("game_end") @db.Timestamptz(3)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  whitePlayer       User?      @relation("WhitePlayer", fields: [whiteId], references: [id], onDelete: SetNull)
  blackPlayer       User?      @relation("BlackPlayer", fields: [blackId], references: [id], onDelete: SetNull)
  moves             GameMove[]

  @@index([whiteId])
  @@index([blackId])
  @@index([gameStart])
  @@map("games")
}

model GameMove {
  id              String   @id @default(uuid()) @db.Uuid
  gameId          String   @map("game_id") @db.Uuid
  ply             Int
  moveNumber      Int      @map("move_number")
  color           String   @db.VarChar(5)
  playedById      String?  @map("played_by_id") @db.Uuid
  san             String   @db.VarChar(10)
  uci             String   @db.VarChar(10)
  fenAfter        String   @map("fen_after") @db.VarChar(100)
  timeSpentMs     Int?     @map("time_spent_ms")
  timeRemainingMs Int?     @map("time_remaining_ms")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  game            Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  playedBy        User?    @relation(fields: [playedById], references: [id], onDelete: SetNull)

  @@unique([gameId, ply], map: "game_moves_game_id_ply_key")
  @@index([gameId, ply])
  @@map("game_moves")
}
