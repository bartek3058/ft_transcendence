import { useCallback, useEffect, useState } from "react";
import { Link, useParams } from "react-router-dom";
import { Page } from "../components/ui/Page";
import { useAuth } from "../context/AuthContext";
import { useTournamentRealtime } from "../hooks/useTournamentRealtime";
import {
  getTournament,
  joinTournament,
  leaveTournament,
  closeTournamentRegistration,
  cancelTournament,
  checkInTournamentMatch,
  type TournamentDetail,
} from "../services/tournaments";
import "./tournaments.css";

const statusLabels: Record<string, string> = {
  OPEN_FOR_SIGNUP: "Open for signup",
  REGISTRATION_CLOSED: "Registration closed",
  IN_PROGRESS: "In progress",
  FINISHED: "Finished",
  CANCELLED: "Cancelled",
};

function formatDate(value: string) {
  const date = new Date(value);

  if (Number.isNaN(date.getTime())) {
    return "Unknown date";
  }

  return new Intl.DateTimeFormat("en-GB", {
    day: "numeric",
    month: "short",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  }).format(date);
}


function formatCheckInTime(deadline: string, now: number) {
  const remaining = Math.max(
    0,
    new Date(deadline).getTime() - now,
  );

  const totalSeconds = Math.ceil(remaining / 1000);
  const minutes = Math.floor(totalSeconds / 60);
  const seconds = totalSeconds % 60;

  return `${String(minutes).padStart(2, "0")}:${String(seconds).padStart(2, "0")}`;
}

export function TournamentDetailsPage() {
  const { id } = useParams<{ id: string }>();
  const { user } = useAuth();

  const [tournament, setTournament] = useState<TournamentDetail | null>(null);

  const [loading, setLoading] = useState(true);
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState("");
  const [reload, setReload] = useState(0);
  const [checkInBusy, setCheckInBusy] = useState<string | null>(null);
  const [now, setNow] = useState(() => Date.now());

  useEffect(() => {
    const timer = window.setInterval(() => {
      setNow(Date.now());
    }, 1000);

    return () => window.clearInterval(timer);
  }, []);


  const refreshTournament = useCallback(() => {
    setReload((value) => value + 1);
  }, []);

  const realtimeStatus = useTournamentRealtime(
    id,
    Boolean(user && id),
    refreshTournament,
  );

  useEffect(() => {
    let active = true;

    setLoading(true);
    setError("");
    setTournament(null);

    if (!id) {
      setError("Missing tournament ID");
      setLoading(false);
      return;
    }

    getTournament(id)
      .then((result) => {
        if (active) {
          setTournament(result);
        }
      })
      .catch((cause) => {
        if (active) {
          setError(cause instanceof Error ? cause.message : "Loading failed");
        }
      })
      .finally(() => {
        if (active) {
          setLoading(false);
        }
      });

    return () => {
      active = false;
    };
  }, [id, reload]);


  async function handleMatchCheckIn(matchId: string) {
    if (!id || checkInBusy || busy) return;

    setCheckInBusy(matchId);
    setError("");

    try {
      const result = await checkInTournamentMatch(id, matchId);
      const fresh = await getTournament(id);
      setTournament(fresh);

      if (result.gameId) {
        window.location.assign(
          `/game/${encodeURIComponent(result.gameId)}?tournamentId=${encodeURIComponent(id)}`,
        );
      }
    } catch (cause) {
      setError(
        cause instanceof Error
          ? cause.message
          : "Unable to check in",
      );
    } finally {
      setCheckInBusy(null);
    }
  }

  async function changeRegistration(action: "join" | "leave") {
    if (!id || busy) return;

    setBusy(true);
    setError("");

    try {
      if (action === "join") {
        await joinTournament(id);
      } else {
        await leaveTournament(id);
      }

      const fresh = await getTournament(id);
      setTournament(fresh);
    } catch (cause) {
      setError(cause instanceof Error ? cause.message : "Action failed");
    } finally {
      setBusy(false);
    }
  }


  async function manageTournament(action: "start" | "cancel") {
    if (!id || !tournament || busy) return;

    if (
      tournament.creator.id !== user?.id ||
      tournament.status !== "OPEN_FOR_SIGNUP"
    ) {
      return;
    }

    const confirmed = window.confirm(
      action === "start"
        ? tournament.currentParticipants < 2
          ? "There are fewer than 2 players. Closing registration will cancel this tournament. Continue?"
          : "Close registration and start the tournament?"
        : "Are you sure you want to cancel this tournament? This cannot be undone."
    );

    if (!confirmed) return;

    setBusy(true);
    setError("");

    try {
      if (action === "start") {
        await closeTournamentRegistration(id);
      } else {
        await cancelTournament(id);
      }

      const fresh = await getTournament(id);
      setTournament(fresh);
    } catch (cause) {
      setError(
        cause instanceof Error
          ? cause.message
          : "Tournament action failed"
      );
    } finally {
      setBusy(false);
    }
  }

  if (loading) {
    return (
      <Page title="Tournament" sub="Loading...">
        <p>Loading tournament details...</p>
      </Page>
    );
  }

  if (!tournament) {
    return (
      <Page title="Tournament" sub="Details">
        <p role="alert" className="tournament-error">
          {error || "Tournament not found"}
        </p>

        <Link to="/tournaments">← Back to tournaments</Link>
      </Page>
    );
  }

  const isJoined = tournament.participants.some(
    (participant) => participant.userId === user?.id,
  );

  const registrationOpen =
    tournament.status === "OPEN_FOR_SIGNUP" &&
    new Date(tournament.registrationDeadline).getTime() > Date.now();

  const isFull = tournament.currentParticipants >= tournament.maxParticipants;

  const rounds = [
    ...new Set(tournament.matches.map((match) => match.round)),
  ].sort((a, b) => a - b);

  const statusClass = tournament.status.toLowerCase().replace(/_/g, "-");

  const playerProgress =
    tournament.maxParticipants > 0
      ? Math.min(
          100,
          (tournament.currentParticipants / tournament.maxParticipants) * 100,
        )
      : 0;

  return (
    <Page title={tournament.title} sub="Tournament details">
      <div className="tournament-details">
        <Link className="tournament-back" to="/tournaments">
          ← Back to tournaments
        </Link>

        {/* TOURNAMENT HEADER */}

        <section className="tournament-hero">
          <div className="tournament-hero-top">
            <div>
              <span className="tournament-eyebrow">CHESSHUB TOURNAMENT</span>

              <h2 className="tournament-hero-title">{tournament.title}</h2>

              {tournament.description && (
                <p className="tournament-description">
                  {tournament.description}
                </p>
              )}
            </div>

            <div className="tournament-hero-badges">
              <span
                className={`tournament-realtime tournament-realtime--${realtimeStatus}`}
                title={
                  realtimeStatus === "connected"
                    ? "Tournament updates are live"
                    : "Waiting for realtime connection"
                }
              >
                <span className="tournament-realtime-dot" />

                {realtimeStatus === "connected"
                  ? "Live updates"
                  : realtimeStatus === "connecting"
                    ? "Connecting..."
                    : "Offline updates"}
              </span>

              <span
                className={`tournament-status tournament-status--${statusClass}`}
              >
                <span className="tournament-status-dot" />

                {statusLabels[tournament.status] ??
                  tournament.status.replace(/_/g, " ")}
              </span>
            </div>
          </div>

          {/* STATISTICS */}

          <div className="tournament-stats">
            <div className="tournament-stat">
              <span className="tournament-stat-label">PLAYERS</span>

              <strong className="tournament-stat-value">
                {tournament.currentParticipants}
                <span> / {tournament.maxParticipants}</span>
              </strong>

              <div className="tournament-progress">
                <div
                  className="tournament-progress-fill"
                  style={{ width: `${playerProgress}%` }}
                />
              </div>
            </div>

            <div className="tournament-stat">
              <span className="tournament-stat-label">ORGANIZER</span>

              <Link
                className="tournament-stat-value tournament-stat-link"
                to={`/users/${tournament.creator.id}`}
              >
                {tournament.creator.username}
              </Link>

              <span className="tournament-stat-hint">Tournament creator</span>
            </div>

            <div className="tournament-stat">
              <span className="tournament-stat-label">
                REGISTRATION DEADLINE
              </span>

              <strong className="tournament-stat-value tournament-date">
                {formatDate(tournament.registrationDeadline)}
              </strong>

              <span className="tournament-stat-hint">
                Registration closes at this time
              </span>
            </div>
          </div>

          {/* CHAMPION */}

          {tournament.champion && (
            <div className="tournament-champion">
              🏆 Champion: <strong>{tournament.champion.username}</strong>
            </div>
          )}

          {/* ACTIONS */}

          <div className="tournament-actions">
            <div className="tournament-registration-info">
              {isJoined ? (
                <span className="tournament-registered">
                  <span className="tournament-registered-icon">✓</span>
                  You are registered
                </span>
              ) : registrationOpen && !isFull ? (
                <span className="tournament-action-hint">
                  Registration is open
                </span>
              ) : (
                <span className="tournament-action-hint">
                  {isFull ? "Tournament is full" : "Registration unavailable"}
                </span>
              )}
            </div>

            <div className="tournament-action-buttons">
              <button
                type="button"
                className="tournament-secondary"
                disabled={busy || loading}
                onClick={refreshTournament}
              >
                ↻ Refresh
              </button>

              {registrationOpen && (
                <button
                  type="button"
                  className={
                    isJoined
                      ? "tournament-button-danger"
                      : "tournament-button-primary"
                  }
                  disabled={busy || (!isJoined && isFull)}
                  onClick={() =>
                    void changeRegistration(isJoined ? "leave" : "join")
                  }
                >
                  {busy
                    ? "Please wait..."
                    : isJoined
                      ? "Leave tournament"
                      : isFull
                        ? "Tournament full"
                        : "Join tournament"}
                </button>
              )}
            </div>
          </div>

          {error && (
            <p role="alert" className="tournament-error">
              {error}
            </p>
          )}
        </section>


        {/* ORGANIZER CONTROLS */}

        {tournament.creator.id === user?.id &&
          tournament.status === "OPEN_FOR_SIGNUP" && (
            <section className="tournament-section">
              <div className="tournament-section-heading">
                <div>
                  <span className="tournament-eyebrow">
                    MANAGEMENT
                  </span>
                  <h2>Organizer controls</h2>
                </div>
              </div>

              <div className="tournament-organizer-panel">
                <div className="tournament-organizer-description">
                  <h3>Manage your tournament</h3>
                  <p>
                    Start the tournament when players are ready,
                    or cancel it before the competition begins.
                  </p>
                  <p>
                    Registered players:{" "}
                    <strong>
                      {tournament.currentParticipants}/
                      {tournament.maxParticipants}
                    </strong>
                  </p>
                </div>

                <div className="tournament-organizer-actions">
                  <button
                    type="button"
                    className="tournament-button-primary"
                    disabled={
                      busy ||
                      tournament.currentParticipants < 2
                    }
                    onClick={() => void manageTournament("start")}
                  >
                    {busy ? "Please wait..." : "Start tournament"}
                  </button>

                  <button
                    type="button"
                    className="tournament-button-danger"
                    disabled={busy}
                    onClick={() => void manageTournament("cancel")}
                  >
                    Cancel tournament
                  </button>
                </div>
              </div>
            </section>
          )}

        {/* PARTICIPANTS */}

        <section className="tournament-section">
          <div className="tournament-section-heading">
            <div>
              <span className="tournament-eyebrow">PLAYERS</span>

              <h2>Participants</h2>
            </div>

            <span className="tournament-count">
              {tournament.participants.length} registered
            </span>
          </div>

          <div className="tournament-participants">
            {tournament.participants.length === 0 ? (
              <div className="tournament-empty">No participants yet.</div>
            ) : (
              tournament.participants.map((participant) => {
                const isOrganizer =
                  participant.userId === tournament.creator.id;

                return (
                  <div
                    className="tournament-participant"
                    key={participant.userId}
                  >
                    <div className="tournament-avatar">
                      {participant.username.charAt(0).toUpperCase()}
                    </div>

                    <div className="tournament-participant-info">
                      <Link to={`/users/${participant.userId}`}>
                        {participant.username}
                      </Link>

                      <span>
                        {isOrganizer ? "Organizer" : "Tournament participant"}
                      </span>
                    </div>

                    {participant.seed !== null && (
                      <span className="tournament-seed">
                        Seed #{participant.seed}
                      </span>
                    )}

                    {participant.userId === user?.id && (
                      <span className="tournament-you">You</span>
                    )}
                  </div>
                );
              })
            )}
          </div>
        </section>

        {/* TOURNAMENT BRACKET */}

        <section className="tournament-section">
          <div className="tournament-section-heading">
            <div>
              <span className="tournament-eyebrow">MATCHES</span>

              <h2>Tournament bracket</h2>
            </div>

            {rounds.length > 0 && (
              <span className="tournament-count">{rounds.length} rounds</span>
            )}
          </div>

          {rounds.length === 0 ? (
            <div className="tournament-bracket-empty">
              <div className="tournament-bracket-icon">♟</div>

              <h3>Waiting for the tournament to start</h3>

              <p>
                The bracket will appear when registration closes and matches are
                generated.
              </p>
            </div>
          ) : (
            <div className="tournament-bracket-grid">
              {rounds.map((round) => (
                <div className="tournament-round" key={round}>
                  <h3>Round {round}</h3>

                  {tournament.matches
                    .filter((match) => match.round === round)
                    .sort((a, b) => a.matchIndex - b.matchIndex)
                    .map((match) => {
                      const player1Won =
                        match.winnerId !== null &&
                        match.winnerId === match.player1?.id;

                      const player2Won =
                        match.winnerId !== null &&
                        match.winnerId === match.player2?.id;

                      const isPlayer1 = match.player1?.id === user?.id;
                      const isPlayer2 = match.player2?.id === user?.id;
                      const isCurrentPlayer = Boolean(
                        user && (isPlayer1 || isPlayer2),
                      );

                      const alreadyCheckedIn =
                        (isPlayer1 && match.player1CheckedIn) ||
                        (isPlayer2 && match.player2CheckedIn);

                      const deadlineTime = match.checkInDeadline
                        ? new Date(match.checkInDeadline).getTime()
                        : NaN;

                      const hasDeadline = Number.isFinite(deadlineTime);
                      const deadlineExpired =
                        hasDeadline && now >= deadlineTime;

                      const canCheckIn =
                        isCurrentPlayer &&
                        !match.isBye &&
                        match.status === "SCHEDULED" &&
                        hasDeadline &&
                        !deadlineExpired &&
                        !alreadyCheckedIn &&
                        !match.currentGameId;

                      const canPlay =
                        isCurrentPlayer &&
                        Boolean(match.currentGameId) &&
                        match.status !== "COMPLETED";

                      return (
                        <div className="tournament-match" key={match.id}>
                          <div className="tournament-match-top">
                            <span>{match.identifier}</span>

                            <span className="tournament-match-status">
                              {match.status.replace(/_/g, " ")}
                            </span>
                          </div>

                          <div className="tournament-match-players">
                            <div
                              className={
                                player1Won ? "tournament-match-winner" : ""
                              }
                            >
                              <span>{match.player1?.username ?? "TBD"}</span>

                              {player1Won && <span>✓</span>}
                            </div>

                            <div
                              className={
                                player2Won ? "tournament-match-winner" : ""
                              }
                            >
                              <span>{match.player2?.username ?? "TBD"}</span>

                              {player2Won && <span>✓</span>}
                            </div>
                          </div>

                          {(match.checkInDeadline ||
                            match.currentGameId) && (
                            <div className="tournament-match-checkin">
                              {match.checkInDeadline &&
                                !match.currentGameId && (
                                  <>
                                    <div className="tournament-checkin-heading">
                                      <strong>Match check-in</strong>
                                      <span>
                                        {deadlineExpired
                                          ? "Time expired"
                                          : `Time left: ${formatCheckInTime(match.checkInDeadline, now)}`}
                                      </span>
                                    </div>

                                    <div className="tournament-checkin-players">
                                      <span>
                                        {match.player1CheckedIn ? "✓" : "○"}{" "}
                                        {match.player1?.username ?? "TBD"}
                                      </span>
                                      <span>
                                        {match.player2CheckedIn ? "✓" : "○"}{" "}
                                        {match.player2?.username ?? "TBD"}
                                      </span>
                                    </div>

                                    {canCheckIn && (
                                      <button
                                        type="button"
                                        className="tournament-button-primary"
                                        disabled={checkInBusy !== null || busy}
                                        onClick={() =>
                                          void handleMatchCheckIn(match.id)
                                        }
                                      >
                                        {checkInBusy === match.id
                                          ? "Checking in..."
                                          : "Check in"}
                                      </button>
                                    )}

                                    {isCurrentPlayer &&
                                      alreadyCheckedIn && (
                                        <p className="tournament-checkin-confirmed">
                                          ✓ You are checked in. Waiting for opponent.
                                        </p>
                                      )}
                                  </>
                                )}

                              {match.currentGameId && (
                                <>
                                  <span className="tournament-game-id">
                                    Game: {match.currentGameId.slice(0, 8)}
                                  </span>

                                  {canPlay && (
                                    <Link
                                      className="tournament-button-primary tournament-play-link"
                                      to={`/game/${encodeURIComponent(match.currentGameId)}?tournamentId=${encodeURIComponent(id ?? "")}`}
                                    >
                                      Play game
                                    </Link>
                                  )}
                                </>
                              )}
                            </div>
                          )}
                        </div>
                      );
                    })}
                </div>
              ))}
            </div>
          )}
        </section>
      </div>
    </Page>
  );
}
